---
import type { CollectionEntry } from 'astro:content';
import { formatTanggal } from '../data/berita';

interface Props {
  berita: CollectionEntry<'berita'>;
  utama?: boolean;
}
const { berita, utama = false } = Astro.props;
const { judul, tanggal, ringkasan, sampul, sampulAlt, kategori } = berita.data;
---

<article class:list={['kartu', { 'kartu--utama': utama }]}>
  <a class="kartu__foto" href={`/berita/${berita.id}/`} tabindex="-1" aria-hidden="true">
    <img src={sampul} alt={sampulAlt} loading="lazy" decoding="async" />
  </a>
  <div class="kartu__teks">
    <p class="kartu__meta">
      <span class="kartu__kategori">{kategori}</span>
      <time datetime={tanggal.toISOString().slice(0, 10)}>{formatTanggal(tanggal)}</time>
    </p>
    <h3><a href={`/berita/${berita.id}/`}>{judul}</a></h3>
    <p class="kartu__ringkas">{ringkasan}</p>
  </div>
</article>

<style>
  .kartu {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--putih);
    border: 2px solid var(--biru-tua);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: 4px 4px 0 var(--biru-tua);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .kartu:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--biru-tua); }
  .kartu__foto { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--biru-muda); border-bottom: 2px solid var(--biru-tua); }
  .kartu__foto img { width: 100%; height: 100%; object-fit: cover; }
  .kartu__teks { padding: 20px 22px 24px; }
  .kartu__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 0.85rem; color: var(--tinta-2); margin-bottom: 10px; }
  .kartu__kategori {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--pensil-muda);
    color: var(--biru-tua);
    font-weight: 700;
  }
  .kartu h3 { font-size: clamp(1.25rem, 1.8vw, 1.45rem); line-height: 1.15; margin-bottom: 10px; }
  .kartu h3 a { color: inherit; text-decoration: none; }
  /* seluruh kartu bisa diklik lewat tautan judul */
  .kartu h3 a::after { content: ''; position: absolute; inset: 0; }
  .kartu h3 a:hover { text-decoration: underline; }
  .kartu__ringkas { color: var(--tinta-2); margin: 0; font-size: 0.97rem; }

  @media (min-width: 861px) {
    .kartu--utama { grid-column: 1 / -1; grid-template-rows: none; grid-template-columns: 1.2fr 1fr; }
    .kartu--utama .kartu__foto { aspect-ratio: auto; min-height: 340px; border-bottom: 0; border-right: 2px solid var(--biru-tua); }
    .kartu--utama .kartu__teks { padding: clamp(24px, 3vw, 40px); align-self: center; }
    .kartu--utama h3 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
  }
</style>
